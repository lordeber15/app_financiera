# Contraseña de acceso. Usa UNA de las dos opciones:
#  - APP_PASSWORD: texto plano (rápido para desarrollo)
#  - APP_PASSWORD_HASH: hash bcrypt (recomendado en producción). Genera uno con:
#      python scripts/hash_password.py "mi-contraseña"
APP_PASSWORD=admin
#APP_PASSWORD_HASH=$2b$12$...

# Secreto para firmar la cookie de sesión. Cámbialo por uno largo y aleatorio,
# por ejemplo generado con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-value
JWT_EXPIRE_HOURS=168

# Base de datos (SQLite por defecto; ruta relativa a la carpeta backend/)
DATABASE_URL=sqlite:///./data/app.db

# Orígenes permitidos para CORS (separados por coma). En producción con nginx no hace falta.
CORS_ORIGINS=http://localhost:5173

# Pon true si sirves la app por HTTPS
COOKIE_SECURE=false

# Scheduler de resúmenes diarios/semanales
SCHEDULER_ENABLED=true
